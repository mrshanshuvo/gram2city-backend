# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:3000
JWT_SECRET=your_32_character_minimum_random_cryptographic_secret
JWT_REFRESH_SECRET=your_32_character_minimum_random_refresh_secret

# Database Configuration (MongoDB Atlas Connection)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net
DB_NAME=parcelDB

# Stripe Gateway Credentials
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_CURRENCY=bdt

# Google Identity Services (Direct Google OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# Cloudinary Image Storage (https://cloudinary.com/users/register/free)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
